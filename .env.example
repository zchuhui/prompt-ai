# Local placeholders only. Production credentials come from the deployment environment.
# Production object storage is Volcengine TOS through its S3 endpoint, for example:
# S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
# S3_REGION=cn-beijing
# S3_FORCE_PATH_STYLE=false
# From a server in the same region, use the internal endpoint:
# S3_ENDPOINT=https://tos-s3-cn-beijing.ivolces.com
# Do not point the AWS SDK at the native TOS endpoint (tos-<region>.volces.com).
# POSTGRES_* must match the user, password, and database inside DATABASE_URL.
# Docker Compose reads this file with: docker compose --env-file .env.local ...

APP_URL=http://localhost:3000
DATABASE_URL=postgresql://prompt:local-only@localhost:5432/prompt_gallery
POSTGRES_USER=prompt
POSTGRES_PASSWORD=local-only
POSTGRES_DB=prompt_gallery
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=prompt-gallery
S3_ACCESS_KEY_ID=replace-local-key
S3_SECRET_ACCESS_KEY=replace-local-secret
S3_FORCE_PATH_STYLE=true
CSRF_SECRET=replace-with-random-secret
RATE_LIMIT_SECRET=replace-with-random-secret
LOG_LEVEL=info
WORKER_CONCURRENCY=2
